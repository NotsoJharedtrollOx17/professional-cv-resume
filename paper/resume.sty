\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{resume}[2026/08/11 Structured resume layout]

\RequirePackage[letterpaper,margin=0.65in]{geometry}
\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{amssymb}
\RequirePackage{hyperref}
\RequirePackage{enumitem}
\RequirePackage{needspace}
\RequirePackage{microtype}
\RequirePackage{ragged2e}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}

\setmainfont{Source Serif 4}
\definecolor{ResumeAccent}{HTML}{111111}
\definecolor{ResumeLinkBlue}{HTML}{0000EE}
\definecolor{ResumeBlack}{HTML}{111111}

\hypersetup{
  colorlinks=true,
  urlcolor=ResumeLinkBlue,
  linkcolor=ResumeLinkBlue,
  pdfborder={0 0 0}
}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0.4pt}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{1em}
\setlength{\RaggedRightRightskip}{0pt plus 4em}
\color{ResumeBlack}
\AtBeginDocument{\fontsize{10.1pt}{11.35pt}\selectfont\RaggedRight}
\hyphenpenalty=10000
\exhyphenpenalty=10000

\newcommand{\ResumeName}[1]{%
  \par{\centering\fontsize{16pt}{17pt}\selectfont\bfseries #1\par}%
  \vspace{3pt}
}

\newcommand{\ResumeTagline}[1]{%
  {\centering\fontsize{11pt}{12pt}\selectfont\bfseries\color{ResumeAccent}#1\par}%
  \vspace{3pt}
}

\newcommand{\TaglineSep}{\;{\color{ResumeBlack}\bfseries |}\;}

\newcommand{\ResumeMarker}{\textcolor{ResumeAccent}{\raisebox{0.08ex}{\scriptsize$\blacktriangleright$}}}
\newcommand{\ContactSep}{\hspace{0.55em}\ResumeMarker\hspace{0.55em}}
\newcommand{\SkillSep}{\allowbreak\hspace{0.32em plus 0.08em}\ResumeMarker\nobreak\hspace{0.32em plus 0.06em}}
\newcommand{\contactlink}[2]{\href{#1}{\textcolor{ResumeLinkBlue}{\bfseries #2}}}

\newcommand{\ResumeContact}[1]{%
  \par\noindent\rule{\linewidth}{1.25pt}\par
  \vspace{4pt}
  {\centering\small #1\par}%
  \vspace{-1pt}
  \par\noindent\rule{\linewidth}{1.25pt}\par
  \vspace{1.5pt}
}

\newcommand{\ResumeSummary}[1]{%
  \par\vspace{4pt}%
  {\small #1\par}%
  \vspace{-1pt}%
}

\newcommand{\ResumeFooter}[2]{%
  \fancyfoot[L]{\fontsize{8pt}{9pt}\selectfont #1\space |\space #2}%
  \fancyfoot[R]{\fontsize{8pt}{9pt}\selectfont Page \thepage\ of \pageref*{LastPage}}%
}

\newcommand{\cvsection}[1]{%
  \par\Needspace{2.4\baselineskip}%
  \vspace{7pt}%
  {\fontsize{13pt}{14pt}\selectfont\bfseries #1}\par
  \vspace{2.5pt}%
}

\newlength{\ResumeDateReserve}
\setlength{\ResumeDateReserve}{1.55in}

\newcommand{\datedheading}[2]{%
  \par\noindent
  \begingroup
    \hangindent=-\ResumeDateReserve
    \hangafter=-1
    \makebox[0pt][l]{\hspace{\linewidth}\llap{\bfseries #2}}%
    #1\par
  \endgroup
}

\newcommand{\cvtitle}[1]{{\color{ResumeAccent}\bfseries #1}}
\newcommand{\rolecontext}[1]{{\color{ResumeBlack}\normalfont\itshape (#1)}}

\newcommand{\cventry}[5]{%
  \Needspace{4.1\baselineskip}%
  \datedheading{\cvtitle{#1}}{#2}%
  {\itshape #3}\par
  \if\relax\detokenize{#4}\relax\else
    {\bfseries #4:} #5\par
  \fi
}

\newcommand{\cvexperience}[5]{%
  \Needspace{4.1\baselineskip}%
  \datedheading{\cvtitle{#1}}{#2}%
  {\itshape #3}\par
  \if\relax\detokenize{#4}\relax\else
    {\bfseries #4:} #5\par
  \fi
}

\newenvironment{cvitems}{%
  \begin{itemize}[
    leftmargin=2.9em,
    labelsep=0.65em,
    itemsep=1.15pt,
    topsep=1.5pt,
    parsep=0pt,
    partopsep=0pt,
    label={\raisebox{0.16ex}{\scriptsize$\bullet$}}
  ]
}{%
  \end{itemize}\vspace{3pt}
}

\newcommand{\cvrecord}[3]{%
  \Needspace{3.2\baselineskip}%
  \datedheading{\cvtitle{#1}}{#2}%
  #3\par\vspace{7pt}%
}

\newcommand{\cvskill}[2]{%
  {\color{ResumeAccent}\bfseries #1}\par
  {\sloppy\ResumeMarker\hspace{0.32em}#2\par}\vspace{2.2pt}%
}

\newcommand{\cvcredential}[4]{%
  \Needspace{2.5\baselineskip}%
  \datedheading{\cvtitle{\href{#3}{#1}}}{#2}%
  #4\par\vspace{7pt}%
}

\newcommand{\ResumePageContinuation}{\null\vspace*{0.12in}}
